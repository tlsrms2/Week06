  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e2a09077d4ee7f24e92a6a82212c335e, type: 3}
  m_Name: StartDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogDatabase
  sequences:
  - label: 0
    lines:
    - "\uB4DC\uB514\uC5B4\uC654\uAD70."
    - "\uC5EC\uAE30\uB294 \uC774\uC2B9\uACFC \uC800\uC2B9\uC758 \uC0AC\uC774\uC778
      \uC0BC\uB3C4\uB2E4."
    - "\uB098\uB97C \uC774\uAE34\uB2E4\uBA74 \uB108\uC5D0\uAC8C \uB2E4\uC2DC \uC0B4\uC544\uB0A0
      \uAE30\uD68C\uB97C \uC8FC\uC9C0."
    - "\uD5C8\uB098 \uB0B4\uAC00 \uC774\uAE34\uB2E4\uBA74 \uB124 \uB208\uC740 \uB0B4\uAC00
      \uAC00\uC838\uAC00\uB9C8."
    - "\uC790 \uAC8C\uC784\uC744 \uC2DC\uC791\uD558\uC9C0."
    - "\uADDC\uCE59\uC740 \uAC04\uB2E8\uD574."
    - "\uCE74\uB4DC \uC22B\uC790\uB97C \uD569\uCCD0\uC11C 21\uC5D0 \uAC00\uC7A5 \uAC00\uAE5D\uAC8C
      \uB9CC\uB4DC\uB294 \uB188\uC774 \uC774 \uD310\uC758 \uC2B9\uC790\uAC00 \uB418\uB294\uAC70\uC57C."
    - "\uD558\uC9C0\uB9CC \uBA85\uC2EC\uD574."
    - "\uB2E8 1\uC774\uB77C\uB3C4 \uC120\uC744 \uB118\uB294 \uC21C\uAC04 \uB124 \uBAA8\uB4E0
      \uAC74 \uB0B4 \uC190\uC5D0 \uB4E4\uC5B4\uC624\uAC8C \uB420 \uD14C\uB2C8\uAE4C."
  - label: 1
    lines:
    - "\uD310\uC774 \uCEE4\uC84C\uAD70. "
    - "\uC774\uC81C \uCE74\uB4DC \uD569\uC73C\uB85C 108\uC744 \uB9DE\uCDB0\uC57C
      \uD574.  "
    - "\uACF1\uD558\uAE30 \uC870\uCEE4\uAC00 \uB124 \uBE48\uC57D\uD55C \uC22B\uC790\uB97C
      \uC21C\uC2DD\uAC04\uC5D0 \uBEE5\uD280\uAE30\uD574 \uC904 \uAC70\uC57C. "
    - "\uBB3C\uB860 \uADF8\uB9CC\uD07C \uC9C0\uC625\uC73C\uB85C \uB5A8\uC5B4\uC9C0\uAE30\uB3C4
      \uC26C\uC6CC\uC84C\uC73C\uB2C8, \uBA38\uB9AC \uC798 \uAD74\uB824\uB77C. "
    - "108\uC744 \uB118\uAE30\uB294 \uC21C\uAC04, \uB124 \uBAA9\uC228\uC904\uC740
      \uBC14\uB85C \uB04A\uAE30\uB294 \uAC70\uB2C8\uAE4C. "
  - label: 2
    lines:
    - "\uC774\uC81C \uBAA9\uD45C\uB294 34\uB2E4.  "
    - "\uC0C8\uB85C \uCD94\uAC00\uD55C \uB098\uB204\uAE30 \uCE74\uB4DC\uAC00 \uB124\uB188\uC758
      \uD130\uC9C8 \uB4EF\uD55C \uC22B\uC790\uB97C \uAE4E\uC544\uC8FC\uACA0\uC9C0\uB9CC,
      \uADF8\uAC8C \uCD95\uBCF5\uC77C\uC9C0 \uC800\uC8FC\uC77C\uC9C0\uB294 \uB450\uACE0
      \uBD10\uC57C\uACA0\uC9C0. "
    - "\uC798 \uB4E4\uC5B4, \uACF1\uD558\uACE0 \uB098\uB204\uBA70 \uC794\uBA38\uB9AC
      \uAD74\uB824\uBD24\uC790 \uD569\uC774 34\uB97C \uB118\uAE30\uBA74 \uADF8\uAC78\uB85C
      \uB05D\uC774\uC57C. "
    - "\uC120\uC744 \uB118\uB294 \uB188\uC5D0\uAC8C \uC904 \uC790\uBE44 \uB530\uC704\uB294
      \uB0B4 \uC0AC\uC804\uC5D0 \uC5C6\uAC70\uB4E0. "
  - label: 3
    lines:
    - "\uB9C8\uC9C0\uB9C9\uC774\uB77C \uADF8\uB7F0\uC9C0 \uACF5\uAE30\uAC00 \uC880
      \uBB34\uAC81\uAD70. \uC774\uBC88 \uBAA9\uD45C\uB294 51\uC774\uB2E4 "
    - "\uACF1\uD558\uAE30\uB85C \uD310\uC744 \uD0A4\uC6B0\uB4E0 \uB098\uB204\uAE30\uB85C
      \uC22B\uC790\uB97C \uAE4E\uB4E0 \uB124 \uC790\uC720\uC9C0\uB9CC, \uC27D\uC9C4
      \uC54A\uC744\uAC70\uC57C. "
    - "\uC5B4\uB514 \uD55C\uBC88 \uBC1C\uBC84\uB465\uCCD0 \uBCF4\uB77C\uACE0. "
  - label: 4
    lines:
    - "\uC9C0\uC625 \uAC19\uC740 \uACC4\uC0B0 \uC18D\uC5D0\uC11C\uB3C4 \uAE30\uC5B4\uCF54
      \uC0B4\uC544\uB0A8\uC558\uAD70. "
    - "\uB124\uB188\uC758 \uADF8 \uC9C0\uB3C5\uD55C \uC6B4\uC778\uC9C0, \uC544\uB2C8\uBA74
      \uCE58\uBC00\uD55C \uBA38\uB9AC\uC2F8\uC6C0\uC778\uC9C0 \uBAB0\uB77C\uB3C4
      \uC774\uBC88 \uD310\uC740 \uD655\uC2E4\uD788 \uB124\uAC00 \uC8FC\uC778\uACF5\uC774\uB2E4. "
    - "\uC88B\uB2E4, \uC57D\uC18D\uB300\uB85C \uADF8 \uBE44\uB9BF\uD55C \uC228\uD1B5\uC744
      \uB2E4\uC2DC \uBD99\uC5EC\uC8FC\uC9C0. "
    - "\uAC00\uC11C \uB124\uAC00 \uADF8\uD1A0\uB85D \uAC08\uAD6C\uD558\uB358 \uC0B6\uC744
      \uB2E4\uC2DC \uC0B4\uC544\uBD10\uB77C. "
